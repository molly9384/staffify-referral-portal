# ============================================================
# Staffify Referral Portal — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# ============================================================

# ---- Database ----
# asyncpg connection string (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost/staffify_referral

# ---- JWT Auth ----
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
# Token expiry in minutes (default 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Hubstaff ----
# Personal Access Token from https://app.hubstaff.com/profile/access-tokens
HUBSTAFF_API_TOKEN=your-hubstaff-personal-access-token
HUBSTAFF_ORG_ID=699143
# Secret used to verify webhook signatures from Hubstaff
HUBSTAFF_WEBHOOK_SECRET=your-webhook-secret

# ---- QuickBooks Online ----
# OAuth 2.0 credentials from https://developer.intuit.com/
QBO_CLIENT_ID=your-qbo-client-id
QBO_CLIENT_SECRET=your-qbo-client-secret
# Must match exactly what's registered in your Intuit app
QBO_REDIRECT_URI=https://your-backend.onrender.com/api/qbo/callback
# Set after OAuth flow completes (or leave blank to auth via /api/qbo/auth)
QBO_REALM_ID=
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=
# "sandbox" or "production"
QBO_ENVIRONMENT=production

# ---- URLs ----
# The publicly accessible URL for this backend service
BASE_URL=https://your-backend.onrender.com
# The publicly accessible URL for the frontend (used for CORS and QBO redirects)
FRONTEND_URL=https://your-frontend.onrender.com
